# ─── Credentials — NEVER commit these ────────────────────────────────────────
.env
*.env
secrets.json
tokens.json
plaid_tokens.json
access_tokens.json

# ─── Database ─────────────────────────────────────────────────────────────────
# Comment out data/*.db if you want to track the database in version control.
# Keeping it excluded is safer — it may contain real financial data.
src/core/data/*.db
src/core/data/*.db-shm
src/core/data/*.db-wal

# ─── Exported CSVs (contain real transaction data) ───────────────────────────
src/core/data/*.csv

# ─── Logs ────────────────────────────────────────────────────────────────────
src/core/logs/
*.log

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ─── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
l_venv/
env/
ENV/

# ─── IDEs and editors ────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ─── Windows system files ────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── macOS system files ───────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ─── Test artifacts ───────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ─── Credentials for third-party services ───────────────────────────────
google_credentials.json